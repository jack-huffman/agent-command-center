{
  "schema": 1,
  "project": "Agent Command Center",
  "profile": "generic",
  "github": {
    "repo": "jack-huffman/agent-command-center",
    "account": "jack-huffman"
  },
  "commitIdentity": {
    "name": "jack-huffman",
    "email": "jack.huffman17@gmail.com"
  },
  "environments": [
    {
      "name": "main",
      "type": "none",
      "org": null,
      "default": true,
      "protected": false,
      "promotesTo": []
    }
  ],
  "environmentSpecific": null,
  "knownDrift": null,
  "trackers": [
    {
      "kind": "github",
      "skipLabels": [
        "milestone"
      ],
      "edits": true
    }
  ],
  "agents": {
    "max": 3,
    "permissionMode": "auto",
    "builder": {
      "model": "claude-opus-5-5"
    },
    "reviewer": {
      "model": "claude-opus-5-5",
      "effort": "medium"
    }
  },
  "autonomy": "review",
  "autopilot": {
    "autoMerge": true,
    "appendOnly": [
      "docs/DECISIONS.md"
    ]
  },
  "dispatch": {
    "shared": [
      "docs/DESIGN.md",
      "README.md",
      "CHANGELOG.md"
    ]
  },
  "worktrees": {
    "root": null,
    "setup": []
  },
  "gates": {
    "required": [
      "check",
      "tests"
    ],
    "builder": [
      "typecheck",
      "near-tests",
      "tests",
      "screenshots"
    ],
    "commands": {
      "check": "npm run check",
      "typecheck": "npm run typecheck",
      "near-tests": "node --no-warnings scripts/near-tests.mjs",
      "screenshots": "node --no-warnings extension/scripts/looked.ts"
    },
    "ratchets": {
      "tests": {
        "command": "node --no-warnings scripts/count-tests.mjs",
        "limit": "floor",
        "label": "tests"
      }
    },
    "heavy": [
      "check",
      "typecheck",
      "near-tests"
    ],
    "tests": [
      "check",
      "near-tests"
    ]
  },
  "secretScan": {
    "paths": [
      "."
    ],
    "exclude": []
  }
}
