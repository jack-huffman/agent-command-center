{
  "schema": 1,
  "project": "Agent Command Center",
  "profile": "generic",
  "github": {
    "repo": "jack-huffman/agent-command-center",
    "account": "jack-huffman",
    "checks": [
      "check"
    ]
  },
  "commitIdentity": {
    "name": "jack-huffman",
    "email": "jack.huffman17@gmail.com"
  },
  "environments": [
    {
      "name": "main",
      "type": "none",
      "org": null,
      "default": true,
      "protected": false,
      "promotesTo": []
    }
  ],
  "environmentSpecific": null,
  "knownDrift": null,
  "trackers": [
    {
      "kind": "github",
      "skipLabels": [
        "milestone"
      ],
      "edits": true
    }
  ],
  "agents": {
    "max": 5,
    "permissionMode": "auto",
    "builder": {
      "model": "claude-opus-5-5"
    },
    "reviewer": {
      "model": "claude-opus-5-5",
      "effort": "medium"
    }
  },
  "autonomy": "review",
  "autopilot": {
    "autoMerge": true,
    "appendOnly": [
      "docs/DECISIONS.md"
    ]
  },
  "dispatch": {
    "shared": [
      "docs/DESIGN.md",
      "README.md",
      "CHANGELOG.md"
    ]
  },
  "worktrees": {
    "root": null,
    "setup": []
  },
  "gates": {
    "required": [
      "check",
      "tests"
    ],
    "builder": [
      "typecheck",
      "near-tests",
      "repo-rules",
      "tests",
      "screenshots"
    ],
    "commands": {
      "check": "npm run check",
      "typecheck": "npm run typecheck",
      "near-tests": "node --no-warnings scripts/near-tests.mjs",
      "repo-rules": "node --no-warnings --test \"scripts/test/*.test.ts\"",
      "screenshots": "node --no-warnings extension/scripts/looked.ts"
    },
    "ratchets": {
      "tests": {
        "command": "node --no-warnings scripts/count-tests.mjs",
        "limit": "floor",
        "label": "tests"
      }
    },
    "heavy": [
      "check",
      "typecheck",
      "near-tests",
      "repo-rules"
    ],
    "tests": [
      "check",
      "near-tests",
      "repo-rules"
    ],
    "nearIndexes": [
      "extension/src/areas.ts",
      "extension/src/extension.ts",
      "extension/webview/areas.ts"
    ]
  },
  "strayFiles": {
    "allow": [
      ".gitattributes"
    ]
  },
  "secretScan": {
    "paths": [
      "."
    ],
    "exclude": [
      "extension/test/scrub.test.ts",
      "packages/core/test/names.test.ts"
    ]
  },
  "tools": [
    {
      "title": "The pinned headless shell",
      "why": "The screenshot run, and the check that its shots were taken, draw every page with Google's headless shell at the pinned version, never the person's own Chrome.",
      "check": "node --no-warnings extension/scripts/browser.ts --check",
      "fix": "npm run browser"
    }
  ]
}
