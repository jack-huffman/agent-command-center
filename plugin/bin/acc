        if (gone.length) problems.push(`${rel} lists files that don't exist: ${gone.slice(0, 3).join(", ")}${gone.length > 3 ? " \u2026" : ""}.`);
        counts.push(`${paths.length} ${label}`);
      }
      return problems.length ? fail2(problems.join(" ")) : pass2(counts.join(", "));
    }
