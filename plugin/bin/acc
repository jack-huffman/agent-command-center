var PREAPPROVAL_MS = 10 * 6e4;
var preapprovalFile = (dir, sessionId) => join7(dir, "approved", `${sessionId.replace(/[^A-Za-z0-9-]/g, "")}.json`);
function preapprove(dir, sessionId, command, now2 = Date.now()) {
  mkdirSync8(join7(dir, "approved"), { recursive: true, mode: 448 });
  writePrivate(preapprovalFile(dir, sessionId), { command, until: now2 + PREAPPROVAL_MS });
}
function takePreapproval(dir, sessionId, command, now2 = Date.now()) {
  const file = preapprovalFile(dir, sessionId);
  const p = readJson(file);
  if (!p || p.command !== command || typeof p.until !== "number" || now2 > p.until) return false;
  rmSync4(file, { force: true });
  return true;
}
var editedMessage = (command) => `The user edited this command in the Command Center. Run exactly this instead, as it is, and carry on:

\`\`\`
${command}
\`\`\``;
function outcomeOf(q, a) {
  if (a.decision === "terminal") return "terminal";
  if (a.decision === "deny") return a.stop ? "denied-stopped" : "denied";
  if (q.tool === "AskUserQuestion") return "answered";
  if (a.command && q.tool === "Bash") return "allowed-edited";
  if (a.mode === "auto") return "allowed-auto-mode";
  if (a.mode === "acceptEdits") return "allowed-accept-edits";
  if (a.always) return a.scope === "project" ? "allowed-for-project" : "allowed-for-session";
  return "allowed";
}
function listeners(dir, now2 = Date.now()) {
  let names = [];
  try {
    names = readdirSync2(join7(dir, "listeners")).filter((n) => n.endsWith(".json"));
  } catch {
    return [];
  }
  return names.flatMap((n) => {
    const l = readJson(join7(dir, "listeners", n));
    const ok = !!l && Number.isInteger(l.pid) && typeof l.at === "number" && Array.isArray(l.roots) && now2 - l.at < LISTENER_STALE_MS && alive(l.pid);
    return ok ? [l] : [];
  });
}
var covered = (ls, cwd) => ls.some((l) => l.roots.some((r) => typeof r === "string" && isUnder(cwd, r)));
function existsQuestionsDir(dir) {
  try {
    return statSync3(join7(dir, "listeners")).isDirectory();
  } catch {
    return false;
  }
}
function parseHookInput(text) {
  let x = null;
  try {
    x = JSON.parse(text);
  } catch {
    return null;
  }
  if (!x || typeof x !== "object") return null;
  const str = (v) => typeof v === "string" && v.length > 0;
  if (!str(x.session_id) || !str(x.cwd) || !str(x.tool_name) || !x.tool_input || typeof x.tool_input !== "object") return null;
  return {
    hook_event_name: String(x.hook_event_name ?? ""),
    session_id: x.session_id,
    cwd: x.cwd,
    transcript_path: str(x.transcript_path) ? x.transcript_path : void 0,
    tool_name: x.tool_name,
    tool_input: x.tool_input,
    permission_suggestions: Array.isArray(x.permission_suggestions) ? x.permission_suggestions : []
  };
}
function isAnswer(a) {
  const x = a;
  if (!x || typeof x !== "object") return false;
  if (x.decision === "terminal") return true;
  if (x.decision === "deny") return (x.message === void 0 || typeof x.message === "string" && x.message.length <= 4e3) && (x.stop === void 0 || typeof x.stop === "boolean");
  if (x.decision !== "allow") return false;
  if (x.always !== void 0 && typeof x.always !== "boolean") return false;
  if (x.scope !== void 0 && x.scope !== "session" && x.scope !== "project") return false;
  if (x.mode !== void 0 && !ALLOWED_MODES.includes(x.mode)) return false;
  if (x.command !== void 0 && !(typeof x.command === "string" && x.command.trim().length > 0 && x.command.length <= 2e4)) return false;
  if (x.answers === void 0) return true;
  const answers = x.answers;
  return !!answers && typeof answers === "object" && Object.values(answers).every((v) => typeof v === "string" && v.length <= 4e3);
}
async function ask(input, opts = {}) {
  const dir = opts.dir ?? questionsDir();
  const now2 = opts.now ?? Date.now;
  const wait = opts.wait ?? ((ms) => new Promise((r) => setTimeout(r, ms)));
  const pollMs = opts.pollMs ?? 300;
  const maxWaitMs = opts.maxWaitMs ?? MAX_WAIT_MS;
  const record = (q, outcome, a) => {
    try {
      appendHistory(dir, {
        v: 1,
        id: q.id,
        sessionId: input.session_id,
        cwd: input.cwd,
        tool: input.tool_name,
        input: input.tool_input,
        askedAt: q.at,
        endedAt: now2(),
        outcome,
        ...a?.decision === "allow" && a.answers ? { answers: a.answers } : {},
        ...a?.decision === "deny" && a.message ? { message: a.message } : {},
        ...a?.decision === "allow" && a.command && input.tool_name === "Bash" ? { command: a.command } : {}
      });
    } catch {
    }
  };
  if (input.tool_name === "Bash" && takePreapproval(dir, input.session_id, String(input.tool_input.command ?? ""), now2())) {
    const id = `${now2().toString(36)}-${randomBytes(4).toString("hex")}`;
    const q = { v: 1, id, pid: opts.pid ?? process.pid, at: now2(), sessionId: input.session_id, cwd: input.cwd, transcript: input.transcript_path ?? null, tool: input.tool_name, input: input.tool_input, suggestions: [] };
    return { question: q, answer: { decision: "allow" } };
  }
  if (!covered(listeners(dir, now2()), input.cwd)) {
    if (listeners(dir, now2()).length || existsQuestionsDir(dir)) record({ id: `${now2().toString(36)}-${randomBytes(4).toString("hex")}`, at: now2() }, "no-window");
    return null;
  }
  ensureDir(dir);
  const question = {
    v: 1,
    id: `${now2().toString(36)}-${randomBytes(4).toString("hex")}`,
    pid: opts.pid ?? process.pid,
    at: now2(),
    sessionId: input.session_id,
    cwd: input.cwd,
    transcript: input.transcript_path ?? null,
    tool: input.tool_name,
    input: input.tool_input,
    suggestions: input.permission_suggestions ?? []
  };
  const file = join7(dir, `${question.id}.json`);
  const answerFile = join7(dir, `${question.id}.answer.json`);
  writePrivate(file, question);
  const started = now2();
  try {
    for (let i = 0; ; i++) {
      const a = readJson(answerFile);
      if (isAnswer(a)) {
        record(question, outcomeOf(question, a), a);
        if (a.decision === "allow" && a.command && question.tool === "Bash") preapprove(dir, question.sessionId, a.command, now2());
        return a.decision === "terminal" ? null : { question, answer: a };
      }
      if (opts.signal?.aborted) {
        record(question, "stopped");
        return null;
      }
      if (now2() - started > maxWaitMs) {
        record(question, "timed-out");
        return null;
      }
      if (i % 10 === 9 && !covered(listeners(dir, now2()), input.cwd)) {
        record(question, "window-closed");
        return null;
      }
      await wait(pollMs);
    }
  } finally {
    rmSync4(file, { force: true });
    rmSync4(answerFile, { force: true });
  }
}
function hookOutput(q, a) {
  if (a.decision === "terminal") return null;
  let decision;
  if (a.decision === "deny") {
    decision = { behavior: "deny", message: a.message?.trim() ? `The user said no, from the Command Center: ${a.message.trim()}` : "The user said no, from the Command Center." };
    if (a.stop) decision.interrupt = true;
  } else if (q.tool === "AskUserQuestion") {
    decision = { behavior: "allow", updatedInput: { ...q.input, answers: a.answers ?? {} } };
  } else {
    if (a.command && q.tool === "Bash") return { hookSpecificOutput: { hookEventName: "PermissionRequest", decision: { behavior: "deny", message: editedMessage(a.command) } } };
    decision = { behavior: "allow" };
    const updates = [];
    if (a.always && q.suggestions.length) updates.push(...q.suggestions.map((s) => ({ ...s, destination: a.scope === "project" ? "localSettings" : "session" })));
    if (a.mode) updates.push({ type: "setMode", mode: a.mode, destination: "session" });
    if (updates.length) decision.updatedPermissions = updates;
  }
  return { hookSpecificOutput: { hookEventName: "PermissionRequest", decision } };
}
function permissionHook(command) {
  return { PermissionRequest: [{ matcher: "*", hooks: [{ type: "command", command: `${command} hook permission`, timeout: HOOK_TIMEOUT_S }] }] };
}

