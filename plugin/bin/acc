        if (!e.org) {
          problems.push(`${e.name} has no org alias.`);
          continue;
        }
        const d = sfJson(ctx, ["org", "display", "-o", e.org]);
        if (d.status !== 0) {
          problems.push(`"${e.org}" isn't logged in (${d.message ?? "sf failed"}).`);
          continue;
