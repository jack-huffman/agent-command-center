import { randomUUID } from "node:crypto";
import { existsSync as existsSync6, mkdirSync as mkdirSync9, readdirSync as readdirSync3, readFileSync as readFileSync9, renameSync as renameSync4, rmSync as rmSync5, writeFileSync as writeFileSync10 } from "node:fs";
