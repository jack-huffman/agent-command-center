{
  "name": "agent-command-center",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p extension/tsconfig.json && tsc -p extension/webview/tsconfig.json",
    "test": "node --no-warnings --test --test-reporter=spec \"packages/*/test/*.test.ts\" \"extension/test/*.test.ts\"",
    "build": "node --no-warnings scripts/build.mjs",
    "screenshot": "node --no-warnings extension/scripts/screenshot.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "acc": "node --no-warnings packages/cli/src/main.ts",
    "package": "npm run check && mkdir -p dist && cd extension && vsce package --no-dependencies --skip-license -o ../dist/",
    "install-extension": "node scripts/install-extension.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "1.95.0",
    "@vscode/codicons": "^0.0.44",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "typescript": "^7.0.2"
  }
}
