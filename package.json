{
  "name": "agent-command-center",
  "version": "0.42.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p extension/tsconfig.json && tsc -p extension/webview/tsconfig.json",
    "test": "node --no-warnings --import ./scripts/compile-cache.ts --test --test-timeout=300000 --test-reporter=spec \"packages/*/test/*.test.ts\" \"extension/test/*.test.ts\" \"scripts/test/*.test.ts\"",
    "build": "node --no-warnings scripts/build.mjs",
    "screenshot": "node --no-warnings extension/scripts/screenshot.ts",
    "browser": "node --no-warnings extension/scripts/browser.ts",
    "check": "node --no-warnings scripts/areas.ts --check && npm run typecheck && npm run build && npm test && node --no-warnings scripts/check-receipt.ts",
    "acc": "node --no-warnings packages/cli/src/main.ts",
    "package": "node --no-warnings scripts/package.mjs",
    "release": "node --no-warnings scripts/release.mjs",
    "set-version": "node --no-warnings scripts/set-version.mjs",
    "install-extension": "node scripts/install-extension.mjs",
    "validate-plugin": "claude plugin validate --strict plugin && claude plugin validate --strict ."
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "1.95.0",
    "@vscode/codicons": "^0.0.44",
    "@vscode/vsce": "^4.0.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "typescript": "^7.0.2"
  }
}
