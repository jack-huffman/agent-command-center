{
  "name": "agent-command-center",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --no-warnings --test --test-reporter=spec \"packages/*/test/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "acc": "node --no-warnings packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
