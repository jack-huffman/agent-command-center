            "id": "B10.ignore-worktrees",
            "title": "Task worktrees are git-ignored",
            "description": "Task worktrees live in .claude/worktrees/ inside the repo (D-022). Ignoring it keeps them out of your main checkout's changes and out of VSCode search.\n\n[Check](command:acc.step.check?%5B%22B10.ignore-worktrees%22%5D)\n[Do it](command:acc.step.fix?%5B%22B10.ignore-worktrees%22%5D)",
            "media": {
              "markdown": "media/steps/B10.ignore-worktrees.md"
            },
            "completionEvents": [
              "onContext:acc.step.B10.ignore-worktrees"
            ]
