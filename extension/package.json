{
  "name": "agent-command-center",
  "displayName": "Agent Command Center",
  "description": "Set up projects for parallel Claude Code agents, then run and watch them from VSCode.",
  "version": "0.4.3",
  "publisher": "JackHuffman",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/jack-huffman/agent-command-center.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "agents",
    "salesforce",
    "worktrees",
    "orchestration"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "acc.doctor",
        "title": "Check setup",
        "category": "Agent Command Center",
        "icon": "$(checklist)"
      },
      {
        "command": "acc.openMachineWalkthrough",
        "title": "Set up this machine",
        "category": "Agent Command Center"
      },
      {
        "command": "acc.openProjectWalkthrough",
        "title": "Onboard this project",
        "category": "Agent Command Center"
      },
      {
        "command": "acc.chooseFolder",
        "title": "Choose the project folder",
        "category": "Agent Command Center"
      },
      {
        "command": "acc.openGuide",
        "title": "Open the onboarding guide",
        "category": "Agent Command Center"
      },
      {
        "command": "acc.step.check",
        "title": "Check step",
        "category": "Agent Command Center",
        "icon": "$(refresh)"
      },
      {
        "command": "acc.step.fix",
        "title": "Fix step",
        "category": "Agent Command Center",
        "icon": "$(wrench)"
      },
      {
        "command": "acc.step.openSetup",
        "title": "Open step in Salesforce",
        "category": "Agent Command Center",
        "icon": "$(globe)"
      },
      {
        "command": "acc.step.confirm",
        "title": "Mark step done",
        "category": "Agent Command Center"
      },
      {
        "command": "acc.setup.refresh",
        "title": "Re-check setup",
        "category": "Agent Command Center",
        "icon": "$(refresh)"
      },
      {
        "command": "acc.task.add",
        "title": "Add task",
        "category": "Agent Command Center",
        "icon": "$(add)"
      },
      {
        "command": "acc.task.importGithub",
        "title": "Import GitHub issues",
        "category": "Agent Command Center",
        "icon": "$(github)"
      },
      {
        "command": "acc.task.importJira",
        "title": "Import from Jira",
        "category": "Agent Command Center",
        "icon": "$(cloud-download)"
      },
      {
        "command": "acc.task.show",
        "title": "Show task details",
        "category": "Agent Command Center"
      },
      {
        "command": "acc.task.move",
        "title": "Move task…",
        "category": "Agent Command Center",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "acc.task.block",
        "title": "Block task…",
        "category": "Agent Command Center",
        "icon": "$(circle-slash)"
      },
      {
        "command": "acc.task.unblock",
        "title": "Unblock task",
        "category": "Agent Command Center",
        "icon": "$(debug-restart)"
      },
      {
        "command": "acc.task.openTicket",
        "title": "Open ticket",
        "category": "Agent Command Center",
        "icon": "$(link-external)"
      },
      {
        "command": "acc.task.copyId",
        "title": "Copy task id",
        "category": "Agent Command Center"
      },
      {
        "command": "acc.tasks.refresh",
        "title": "Refresh tasks",
        "category": "Agent Command Center",
        "icon": "$(refresh)"
      },
      {
        "command": "acc.agent.new",
        "title": "Start a background agent…",
        "category": "Agent Command Center",
        "icon": "$(add)"
      },
      {
        "command": "acc.agent.attach",
        "title": "Attach",
        "category": "Agent Command Center",
        "icon": "$(terminal)"
      },
      {
        "command": "acc.agent.logs",
        "title": "Show logs",
        "category": "Agent Command Center",
        "icon": "$(output)"
      },
      {
        "command": "acc.agent.stop",
        "title": "Stop agent",
        "category": "Agent Command Center",
        "icon": "$(debug-stop)"
      },
      {
        "command": "acc.agent.openFolder",
        "title": "Open its folder",
        "category": "Agent Command Center",
        "icon": "$(folder-opened)"
      },
      {
        "command": "acc.agents.refresh",
        "title": "Refresh agents",
        "category": "Agent Command Center",
        "icon": "$(refresh)"
      },
      {
        "command": "acc.worktree.open",
        "title": "Open in new window",
        "category": "Agent Command Center",
        "icon": "$(empty-window)"
      },
      {
        "command": "acc.worktree.terminal",
        "title": "Open terminal here",
        "category": "Agent Command Center",
        "icon": "$(terminal)"
      },
      {
        "command": "acc.worktree.reveal",
        "title": "Reveal in Finder",
        "category": "Agent Command Center",
        "icon": "$(folder-opened)"
      },
      {
        "command": "acc.worktree.remove",
        "title": "Remove worktree…",
        "category": "Agent Command Center",
        "icon": "$(trash)"
      },
      {
        "command": "acc.worktrees.refresh",
        "title": "Refresh worktrees",
        "category": "Agent Command Center",
        "icon": "$(refresh)"
      },
      {
        "command": "acc.env.openOrg",
        "title": "Open org",
        "category": "Agent Command Center",
        "icon": "$(globe)"
      },
      {
        "command": "acc.env.openGithub",
        "title": "Open branch on GitHub",
        "category": "Agent Command Center",
        "icon": "$(github)"
      },
      {
        "command": "acc.env.compare",
        "title": "Compare with production",
        "category": "Agent Command Center",
        "icon": "$(diff)"
      },
      {
        "command": "acc.env.copyBranch",
        "title": "Copy branch name",
        "category": "Agent Command Center"
      },
      {
        "command": "acc.open.tasks",
        "title": "Open the Tasks board as a tab",
        "category": "Agent Command Center",
        "icon": "$(link-external)"
      },
      {
        "command": "acc.open.agents",
        "title": "Open Agents as a tab",
        "category": "Agent Command Center",
        "icon": "$(link-external)"
      },
      {
        "command": "acc.open.worktrees",
        "title": "Open Worktrees as a tab",
        "category": "Agent Command Center",
        "icon": "$(link-external)"
      },
      {
        "command": "acc.open.environments",
        "title": "Open Environments as a tab",
        "category": "Agent Command Center",
        "icon": "$(link-external)"
      },
      {
        "command": "acc.open.setup",
        "title": "Open Setup as a tab",
        "category": "Agent Command Center",
        "icon": "$(link-external)"
      },
      {
        "command": "acc.task.dispatch",
        "title": "Dispatch to an agent",
        "category": "Agent Command Center",
        "icon": "$(rocket)"
      },
      {
        "command": "acc.task.attach",
        "title": "Attach to its agent",
        "category": "Agent Command Center",
        "icon": "$(terminal)"
      },
      {
        "command": "acc.task.openWorktree",
        "title": "Open its worktree",
        "category": "Agent Command Center",
        "icon": "$(empty-window)"
      },
      {
        "command": "acc.task.abandon",
        "title": "Abandon…",
        "category": "Agent Command Center",
        "icon": "$(debug-stop)"
      },
      {
        "command": "acc.task.cleanup",
        "title": "Clean up its worktree…",
        "category": "Agent Command Center",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "acc.step.check",
          "when": "false"
        },
        {
          "command": "acc.step.fix",
          "when": "false"
        },
        {
          "command": "acc.step.openSetup",
          "when": "false"
        },
        {
          "command": "acc.step.confirm",
          "when": "false"
        },
        {
          "command": "acc.task.show",
          "when": "false"
        },
        {
          "command": "acc.task.move",
          "when": "false"
        },
        {
          "command": "acc.task.block",
          "when": "false"
        },
        {
          "command": "acc.task.unblock",
          "when": "false"
        },
        {
          "command": "acc.task.openTicket",
          "when": "false"
        },
        {
          "command": "acc.task.copyId",
          "when": "false"
        },
        {
          "command": "acc.agent.attach",
          "when": "false"
        },
        {
          "command": "acc.agent.logs",
          "when": "false"
        },
        {
          "command": "acc.agent.stop",
          "when": "false"
        },
        {
          "command": "acc.agent.openFolder",
          "when": "false"
        },
        {
          "command": "acc.worktree.open",
          "when": "false"
        },
        {
          "command": "acc.worktree.terminal",
          "when": "false"
        },
        {
          "command": "acc.worktree.reveal",
          "when": "false"
        },
        {
          "command": "acc.worktree.remove",
          "when": "false"
        },
        {
          "command": "acc.env.openOrg",
          "when": "false"
        },
        {
          "command": "acc.env.openGithub",
          "when": "false"
        },
        {
          "command": "acc.env.compare",
          "when": "false"
        },
        {
          "command": "acc.env.copyBranch",
          "when": "false"
        },
        {
          "command": "acc.task.dispatch",
          "when": "false"
        },
        {
          "command": "acc.task.attach",
          "when": "false"
        },
        {
          "command": "acc.task.openWorktree",
          "when": "false"
        },
        {
          "command": "acc.task.abandon",
          "when": "false"
        },
        {
          "command": "acc.task.cleanup",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "acc.open.setup",
          "when": "view == acc.setup",
          "group": "navigation@0"
        },
        {
          "command": "acc.open.environments",
          "when": "view == acc.environments",
          "group": "navigation@0"
        },
        {
          "command": "acc.open.worktrees",
          "when": "view == acc.worktrees",
          "group": "navigation@0"
        },
        {
          "command": "acc.open.agents",
          "when": "view == acc.agents",
          "group": "navigation@0"
        },
        {
          "command": "acc.open.tasks",
          "when": "view == acc.tasks",
          "group": "navigation@0"
        },
        {
          "command": "acc.task.add",
          "when": "view == acc.tasks && acc.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "acc.task.importGithub",
          "when": "view == acc.tasks && acc.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "acc.tasks.refresh",
          "when": "view == acc.tasks",
          "group": "navigation@3"
        },
        {
          "command": "acc.task.importJira",
          "when": "view == acc.tasks && acc.hasProject",
          "group": "more@1"
        },
        {
          "command": "acc.agent.new",
          "when": "view == acc.agents",
          "group": "navigation@1"
        },
        {
          "command": "acc.agents.refresh",
          "when": "view == acc.agents",
          "group": "navigation@2"
        },
        {
          "command": "acc.worktrees.refresh",
          "when": "view == acc.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "acc.setup.refresh",
          "when": "view == acc.setup",
          "group": "navigation@1"
        },
        {
          "command": "acc.openProjectWalkthrough",
          "when": "view == acc.setup",
          "group": "more@1"
        },
        {
          "command": "acc.openMachineWalkthrough",
          "when": "view == acc.setup",
          "group": "more@2"
        }
      ],
      "view/item/context": [
        {
          "command": "acc.task.dispatch",
          "when": "view == acc.tasks && viewItem =~ /\\bdispatchable\\b/",
          "group": "inline@0"
        },
        {
          "command": "acc.task.attach",
          "when": "view == acc.tasks && viewItem =~ /\\bhasAgent\\b/",
          "group": "inline@0"
        },
        {
          "command": "acc.task.dispatch",
          "when": "view == acc.tasks && viewItem =~ /\\bdispatchable\\b/",
          "group": "0_agent@1"
        },
        {
          "command": "acc.task.attach",
          "when": "view == acc.tasks && viewItem =~ /\\bhasAgent\\b/",
          "group": "0_agent@2"
        },
        {
          "command": "acc.task.openWorktree",
          "when": "view == acc.tasks && viewItem =~ /\\bhasWorktree\\b/",
          "group": "0_agent@3"
        },
        {
          "command": "acc.task.abandon",
          "when": "view == acc.tasks && viewItem =~ /\\btask-running\\b/",
          "group": "0_agent@4"
        },
        {
          "command": "acc.task.cleanup",
          "when": "view == acc.tasks && viewItem =~ /\\bcleanable\\b/",
          "group": "0_agent@5"
        },
        {
          "command": "acc.task.move",
          "when": "view == acc.tasks && viewItem =~ /\\bmoveInline\\b/",
          "group": "inline@1"
        },
        {
          "command": "acc.task.openTicket",
          "when": "view == acc.tasks && viewItem =~ /\\bhasUrl\\b/",
          "group": "inline@2"
        },
        {
          "command": "acc.task.show",
          "when": "view == acc.tasks && viewItem =~ /\\btask\\b/",
          "group": "1_view@1"
        },
        {
          "command": "acc.task.openTicket",
          "when": "view == acc.tasks && viewItem =~ /\\bhasUrl\\b/",
          "group": "1_view@2"
        },
        {
          "command": "acc.task.move",
          "when": "view == acc.tasks && viewItem =~ /\\btask\\b/",
          "group": "2_change@1"
        },
        {
          "command": "acc.task.block",
          "when": "view == acc.tasks && viewItem =~ /\\btask-(todo|running|review|rework)\\b/",
          "group": "2_change@2"
        },
        {
          "command": "acc.task.unblock",
          "when": "view == acc.tasks && viewItem =~ /\\btask-blocked\\b/",
          "group": "2_change@3"
        },
        {
          "command": "acc.task.copyId",
          "when": "view == acc.tasks && viewItem =~ /\\btask\\b/",
          "group": "3_copy@1"
        },
        {
          "command": "acc.agent.new",
          "when": "view == acc.agents && viewItem =~ /\\bagentPlace\\b/",
          "group": "inline@1"
        },
        {
          "command": "acc.agent.attach",
          "when": "view == acc.agents && viewItem =~ /\\bagentBackground\\b/",
          "group": "inline@1"
        },
        {
          "command": "acc.agent.stop",
          "when": "view == acc.agents && viewItem =~ /\\bagentBackground\\b/",
          "group": "inline@2"
        },
        {
          "command": "acc.agent.attach",
          "when": "view == acc.agents && viewItem =~ /\\bagentBackground\\b/",
          "group": "1_use@1"
        },
        {
          "command": "acc.agent.logs",
          "when": "view == acc.agents && viewItem =~ /\\bagentBackground\\b/",
          "group": "1_use@2"
        },
        {
          "command": "acc.agent.openFolder",
          "when": "view == acc.agents && viewItem =~ /\\bagent\\b/",
          "group": "1_use@3"
        },
        {
          "command": "acc.agent.stop",
          "when": "view == acc.agents && viewItem =~ /\\bagentBackground\\b/",
          "group": "2_stop@1"
        },
        {
          "command": "acc.worktree.terminal",
          "when": "view == acc.worktrees && viewItem =~ /\\bworktree\\b/",
          "group": "inline@1"
        },
        {
          "command": "acc.worktree.open",
          "when": "view == acc.worktrees && viewItem =~ /\\bworktree\\b/",
          "group": "1_open@1"
        },
        {
          "command": "acc.worktree.terminal",
          "when": "view == acc.worktrees && viewItem =~ /\\bworktree\\b/",
          "group": "1_open@2"
        },
        {
          "command": "acc.worktree.reveal",
          "when": "view == acc.worktrees && viewItem =~ /\\bworktree\\b/",
          "group": "1_open@3"
        },
        {
          "command": "acc.worktree.remove",
          "when": "view == acc.worktrees && viewItem =~ /\\bworktreeLinked\\b/",
          "group": "2_remove@1"
        },
        {
          "command": "acc.env.openOrg",
          "when": "view == acc.environments && viewItem =~ /\\benvWithOrg\\b/",
          "group": "inline@1"
        },
        {
          "command": "acc.env.openGithub",
          "when": "view == acc.environments && viewItem =~ /\\benvOnGithub\\b/",
          "group": "inline@2"
        },
        {
          "command": "acc.env.openOrg",
          "when": "view == acc.environments && viewItem =~ /\\benvWithOrg\\b/",
          "group": "1_open@1"
        },
        {
          "command": "acc.env.openGithub",
          "when": "view == acc.environments && viewItem =~ /\\benvOnGithub\\b/",
          "group": "1_open@2"
        },
        {
          "command": "acc.env.compare",
          "when": "view == acc.environments && viewItem =~ /\\benvNotCurrent\\b/",
          "group": "2_compare@1"
        },
        {
          "command": "acc.env.copyBranch",
          "when": "view == acc.environments && viewItem =~ /\\benv\\b/",
          "group": "3_copy@1"
        },
        {
          "command": "acc.step.fix",
          "when": "view == acc.setup && viewItem =~ /\\bstepFixable\\b/",
          "group": "inline@1"
        },
        {
          "command": "acc.step.check",
          "when": "view == acc.setup && viewItem =~ /\\bstep\\b/",
          "group": "1_step@1"
        },
        {
          "command": "acc.step.fix",
          "when": "view == acc.setup && viewItem =~ /\\bstepFixable\\b/",
          "group": "1_step@2"
        },
        {
          "command": "acc.step.openSetup",
          "when": "view == acc.setup && viewItem =~ /\\bstepSetup\\b/",
          "group": "1_step@3"
        },
        {
          "command": "acc.openGuide",
          "when": "view == acc.setup && viewItem =~ /\\bstepDocs\\b/",
          "group": "1_step@4"
        }
      ],
      "webview/context": [
        {
          "command": "acc.agent.attach",
          "when": "webviewId == 'acc.agents' && webviewSection == 'agent' && agentBackground",
          "group": "1_use@1"
        },
        {
          "command": "acc.agent.logs",
          "when": "webviewId == 'acc.agents' && webviewSection == 'agent' && agentBackground",
          "group": "1_use@2"
        },
        {
          "command": "acc.agent.openFolder",
          "when": "webviewId == 'acc.agents' && webviewSection == 'agent'",
          "group": "2_open@1"
        },
        {
          "command": "acc.agent.stop",
          "when": "webviewId == 'acc.agents' && webviewSection == 'agent' && agentBackground",
          "group": "3_stop@1"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "acc.machine",
        "title": "Agent Command Center: set up this machine",
        "description": "Tools and accounts the orchestrator needs. Each step ticks itself when its check passes.",
        "steps": [
          {
            "id": "A1.git",
            "title": "git 2.40 or later",
            "description": "Worktrees and the shared git directory need a recent git.\n\n[Check](command:acc.step.check?%5B%22A1.git%22%5D)\n[Do it](command:acc.step.fix?%5B%22A1.git%22%5D)",
            "media": {
              "markdown": "media/steps/A1.git.md"
            },
            "completionEvents": [
              "onContext:acc.step.A1.git"
            ]
          },
          {
            "id": "A1.node",
            "title": "Node 20 or later",
            "description": "The acc CLI runs on Node.\n\n[Check](command:acc.step.check?%5B%22A1.node%22%5D)\n[Do it](command:acc.step.fix?%5B%22A1.node%22%5D)",
            "media": {
              "markdown": "media/steps/A1.node.md"
            },
            "completionEvents": [
              "onContext:acc.step.A1.node"
            ]
          },
          {
            "id": "A1.gh",
            "title": "GitHub CLI",
            "description": "Pull requests, issues and the per-repo account all go through gh.\n\n[Check](command:acc.step.check?%5B%22A1.gh%22%5D)\n[Do it](command:acc.step.fix?%5B%22A1.gh%22%5D)",
            "media": {
              "markdown": "media/steps/A1.gh.md"
            },
            "completionEvents": [
              "onContext:acc.step.A1.gh"
            ]
          },
          {
            "id": "A1.claude",
            "title": "Claude Code CLI with background sessions",
            "description": "Builders run as `claude --bg` sessions (D-009). The VSCode extension ships its own copy, so the terminal CLI can fall far behind.\n\n[Check](command:acc.step.check?%5B%22A1.claude%22%5D)\n[Do it](command:acc.step.fix?%5B%22A1.claude%22%5D)",
            "media": {
              "markdown": "media/steps/A1.claude.md"
            },
            "completionEvents": [
              "onContext:acc.step.A1.claude"
            ]
          },
          {
            "id": "A1.sf",
            "title": "Salesforce CLI",
            "description": "Validation, retrieves and org checks use sf.\n\n[Check](command:acc.step.check?%5B%22A1.sf%22%5D)\n[Do it](command:acc.step.fix?%5B%22A1.sf%22%5D)",
            "media": {
              "markdown": "media/steps/A1.sf.md"
            },
            "completionEvents": [
              "onContext:acc.step.A1.sf"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "A1.code-analyzer",
            "title": "Salesforce Code Analyzer",
            "description": "The `static` check runs `sf code-analyzer`.\n\n[Check](command:acc.step.check?%5B%22A1.code-analyzer%22%5D)\n[Do it](command:acc.step.fix?%5B%22A1.code-analyzer%22%5D)",
            "media": {
              "markdown": "media/steps/A1.code-analyzer.md"
            },
            "completionEvents": [
              "onContext:acc.step.A1.code-analyzer"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "A2.gh-login",
            "title": "Logged in to GitHub",
            "description": "Each repo uses its own account through `gh auth token -u`. Never `gh auth switch`, which changes every session.\n\n[Check](command:acc.step.check?%5B%22A2.gh-login%22%5D)\n[Do it](command:acc.step.fix?%5B%22A2.gh-login%22%5D)",
            "media": {
              "markdown": "media/steps/A2.gh-login.md"
            },
            "completionEvents": [
              "onContext:acc.step.A2.gh-login"
            ]
          },
          {
            "id": "A3.trackers",
            "title": "Tracker connectors",
            "description": "Jira intake goes through the Atlassian connector. GitHub Issues need nothing extra.\n\n[Check](command:acc.step.check?%5B%22A3.trackers%22%5D)\n[I've done this](command:acc.step.confirm?%5B%22A3.trackers%22%5D)",
            "media": {
              "markdown": "media/steps/A3.trackers.md"
            },
            "completionEvents": [
              "onContext:acc.step.A3.trackers"
            ]
          }
        ]
      },
      {
        "id": "acc.project",
        "title": "Agent Command Center: onboard a project",
        "description": "Get a repo ready for parallel agents: config, GitHub account, branches per environment, source tracking and safe defaults.",
        "featuredFor": [
          "sfdx-project.json",
          ".acc/config.json"
        ],
        "steps": [
          {
            "id": "B0.repo",
            "title": "Inside the project's repo",
            "description": "Everything per-project hangs off the repo: config, branches, and the ledger in the git directory (D-008).\n\n[Check](command:acc.step.check?%5B%22B0.repo%22%5D)\n[Do it](command:acc.step.fix?%5B%22B0.repo%22%5D)\n[Read the guide](command:acc.openGuide?%5B%22B0.repo%22%5D)",
            "media": {
              "markdown": "media/steps/B0.repo.md"
            },
            "completionEvents": [
              "onContext:acc.step.B0.repo"
            ]
          },
          {
            "id": "B0.config",
            "title": "Project config",
            "description": "`.acc/config.json` names the environments, GitHub account and checks.\n\n[Check](command:acc.step.check?%5B%22B0.config%22%5D)\n[Do it](command:acc.step.fix?%5B%22B0.config%22%5D)",
            "media": {
              "markdown": "media/steps/B0.config.md"
            },
            "completionEvents": [
              "onContext:acc.step.B0.config"
            ]
          },
          {
            "id": "B1.orgs",
            "title": "Every org is listed",
            "description": "Pipelines differ by client, so the config lists every sandbox Production has, with its type (D-018).\n\n[Check](command:acc.step.check?%5B%22B1.orgs%22%5D)\n[Do it](command:acc.step.fix?%5B%22B1.orgs%22%5D)",
            "media": {
              "markdown": "media/steps/B1.orgs.md"
            },
            "completionEvents": [
              "onContext:acc.step.B1.orgs"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "B2.identity",
            "title": "Commit identity",
            "description": "Commits in this repo carry its own name and email, set in the repo only.\n\n[Check](command:acc.step.check?%5B%22B2.identity%22%5D)\n[Do it](command:acc.step.fix?%5B%22B2.identity%22%5D)",
            "media": {
              "markdown": "media/steps/B2.identity.md"
            },
            "completionEvents": [
              "onContext:acc.step.B2.identity"
            ]
          },
          {
            "id": "B2.account",
            "title": "The repo's GitHub account is logged in",
            "description": "acc runs every gh call for this repo as its own account (D-007).\n\n[Check](command:acc.step.check?%5B%22B2.account%22%5D)\n[Do it](command:acc.step.fix?%5B%22B2.account%22%5D)",
            "media": {
              "markdown": "media/steps/B2.account.md"
            },
            "completionEvents": [
              "onContext:acc.step.B2.account"
            ]
          },
          {
            "id": "B2.credentials",
            "title": "git pushes as the right account",
            "description": "gh's own credential helper ignores the username and uses the active account, so a repo can silently push as the wrong one.\n\n[Check](command:acc.step.check?%5B%22B2.credentials%22%5D)\n[Do it](command:acc.step.fix?%5B%22B2.credentials%22%5D)",
            "media": {
              "markdown": "media/steps/B2.credentials.md"
            },
            "completionEvents": [
              "onContext:acc.step.B2.credentials"
            ]
          },
          {
            "id": "B3.gitignore",
            "title": "Client data blocked at the repo root",
            "description": "A backstop. The real safeguard is keeping client data in the Working Files folder.\n\n[Check](command:acc.step.check?%5B%22B3.gitignore%22%5D)\n[Do it](command:acc.step.fix?%5B%22B3.gitignore%22%5D)",
            "media": {
              "markdown": "media/steps/B3.gitignore.md"
            },
            "completionEvents": [
              "onContext:acc.step.B3.gitignore"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "B3.data-files",
            "title": "No client data files in git",
            "description": "Contact imports and workbooks belong in the Working Files folder, outside the repo.\n\n[Check](command:acc.step.check?%5B%22B3.data-files%22%5D)\n[Do it](command:acc.step.fix?%5B%22B3.data-files%22%5D)",
            "media": {
              "markdown": "media/steps/B3.data-files.md"
            },
            "completionEvents": [
              "onContext:acc.step.B3.data-files"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "B3.secrets",
            "title": "No credentials in tracked files",
            "description": "Org auth URLs, tokens and private keys must never be committed.\n\n[Check](command:acc.step.check?%5B%22B3.secrets%22%5D)",
            "media": {
              "markdown": "media/steps/B3.secrets.md"
            },
            "completionEvents": [
              "onContext:acc.step.B3.secrets"
            ]
          },
          {
            "id": "B4.skeleton",
            "title": "Salesforce project skeleton",
            "description": "sfdx-project.json defines the source folders, and local tool state must stay out of git.\n\n[Check](command:acc.step.check?%5B%22B4.skeleton%22%5D)",
            "media": {
              "markdown": "media/steps/B4.skeleton.md"
            },
            "completionEvents": [
              "onContext:acc.step.B4.skeleton"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "B5.baseline",
            "title": "Baseline manifest",
            "description": "Every branch is retrieved with the same component list, so a diff between branches is real drift.\n\n[Check](command:acc.step.check?%5B%22B5.baseline%22%5D)\n[Read the guide](command:acc.openGuide?%5B%22B5.baseline%22%5D)",
            "media": {
              "markdown": "media/steps/B5.baseline.md"
            },
            "completionEvents": [
              "onContext:acc.step.B5.baseline"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "B6.branches",
            "title": "A branch for every environment",
            "description": "Each environment has its own branch, named after it (D-015).\n\n[Check](command:acc.step.check?%5B%22B6.branches%22%5D)\n[Read the guide](command:acc.openGuide?%5B%22B6.branches%22%5D)",
            "media": {
              "markdown": "media/steps/B6.branches.md"
            },
            "completionEvents": [
              "onContext:acc.step.B6.branches"
            ]
          },
          {
            "id": "B6.org-match",
            "title": "Each branch points at the right org",
            "description": "A sandbox's name is in its URL, so the tool can prove a branch deploys where its name says (D-015).\n\n[Check](command:acc.step.check?%5B%22B6.org-match%22%5D)\n[Do it](command:acc.step.fix?%5B%22B6.org-match%22%5D)",
            "media": {
              "markdown": "media/steps/B6.org-match.md"
            },
            "completionEvents": [
              "onContext:acc.step.B6.org-match"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "B8.tracking",
            "title": "Developer sandboxes are source tracked",
            "description": "A Developer sandbox is tracked only if tracking was on when it was created, or switched on inside it afterwards.\n\n[Check](command:acc.step.check?%5B%22B8.tracking%22%5D)\n[Open in Salesforce](command:acc.step.openSetup?%5B%22B8.tracking%22%5D)\n[Read the guide](command:acc.openGuide?%5B%22B8.tracking%22%5D)",
            "media": {
              "markdown": "media/steps/B8.tracking.md"
            },
            "completionEvents": [
              "onContext:acc.step.B8.tracking"
            ],
            "when": "acc.profile != generic"
          },
