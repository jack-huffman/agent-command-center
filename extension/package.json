          {
            "id": "B10.readme",
            "title": "README names every environment",
            "description": "Anyone opening the repo sees which branch is which org, and how changes flow.\n\n[Check](command:acc.step.check?%5B%22B10.readme%22%5D)",
            "media": {
              "markdown": "media/steps/B10.readme.md"
            },
            "completionEvents": [
              "onContext:acc.step.B10.readme"
