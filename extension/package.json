            "media": {
              "markdown": "media/steps/B8.cli-tracking.md"
            },
            "completionEvents": [
              "onContext:acc.step.B8.cli-tracking"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "B9.lists",
            "title": "Environment-specific and known-drift lists",
            "description": "Environment config is never promoted or deployed (D-016), and drift checks need to know what differs by design.\n\n[Check](command:acc.step.check?%5B%22B9.lists%22%5D)\n[Read the guide](command:acc.openGuide?%5B%22B9.lists%22%5D)",
            "media": {
              "markdown": "media/steps/B9.lists.md"
            },
            "completionEvents": [
              "onContext:acc.step.B9.lists"
            ],
            "when": "acc.profile != generic"
          },
          {
            "id": "B10.default-branch",
            "title": "GitHub's default branch is the day-to-day one",
            "description": "New pull requests then target day-to-day work, not a protected environment.\n\n[Check](command:acc.step.check?%5B%22B10.default-branch%22%5D)\n[Do it](command:acc.step.fix?%5B%22B10.default-branch%22%5D)",
            "media": {
              "markdown": "media/steps/B10.default-branch.md"
            },
            "completionEvents": [
              "onContext:acc.step.B10.default-branch"
            ]
          },
          {
            "id": "B10.default-org",
            "title": "The local default org is the day-to-day one",
            "description": "A deploy without --target-org then can't reach Production.\n\n[Check](command:acc.step.check?%5B%22B10.default-org%22%5D)\n[Do it](command:acc.step.fix?%5B%22B10.default-org%22%5D)",
            "media": {
              "markdown": "media/steps/B10.default-org.md"
            },
            "completionEvents": [
              "onContext:acc.step.B10.default-org"
            ],
            "when": "acc.profile != generic"
          },
